# Токен тг бота
BOT_TOKEN = ""

# Для llm (основных мозгов)
LLM_OPEN_API_KEY     = ""
LLM_OPENAI_API_BASE  = 
LLM_MODEL_NAME       = 

# Для ембедингов и реранкера
EMB_LLM_OPEN_API_KEY     = ""
EMB_LLM_OPENAI_API_BASE  = 
EMB_LLM_MODEL_NAME       = 

# Для rag.py
RAG_USE_RERANKER = 1 # использовать реранкер в rag?
RAG_TOOL_MAX_CHARS = 6000 # максимальная сумма символов получаемых ботом от rag

# Для bot.py
WEB_SEARCH_MAX_RESULTS=5 # колво результатов веб-поиска
BOT_WARMUP=1 # поднятие chroma и cross-encoder в боте до первого сообщения


# Для security/ — слои защиты. Все значения рабочие по умолчанию

# Вход (input_layer): что бот принимает от пользователя до обращения к модели
SEC_INPUT_MAX_LEN = 2000 # максимальная длина запроса после нормализации, длиннее — отклоняется целиком (не обрезается)
SEC_RATE_LIMIT = 20 # сколько запросов разрешено с одного chat_id
SEC_RATE_WINDOW_S = 60 # за какой промежуток времени считается лимит выше, в секундах

# Шлюз инструментов (gateway_layer): что разрешено вызывать у агента
SEC_MAX_WEB_QUERY = 200 # максимальная длина запроса к веб-поиску; «http» внутри запроса запрещён всегда
SEC_MAX_KB_QUERY = 500 # максимальная длина запроса к базе знаний
SEC_MAX_STEPS = 8 # сколько вызовов инструментов агент может сделать на один вопрос

# Проводка запроса (runtime)
SEC_RECURSION_LIMIT = 12 # нижняя граница recursion_limit для langgraph; шагов графа всегда больше, чем SEC_MAX_STEPS

# Ошибки и вывод (secrets_layer, obs_layer)
SEC_MAX_ERROR_CHARS = 300 # до какой длины укорачивается сводка об ошибке, которую показывает бот
SEC_AUDIT_LOG = security_audit.jsonl # журнал событий (только длина и хеш запроса, без содержимого); пусто = не писать
SEC_KILL_SWITCH_FILE = STOP_BOT # файл-выключатель: появился — бот отвечает, что остановлен; пусто = выключатель отключён



