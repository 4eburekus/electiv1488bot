# Скопируйте в .env (cp .env.example .env) и заполните нужный блок. Файл .env в git не попадает.
# Без .env всё работает на учебной имитации модели (mock): тесты и набор атак проходят без сети.

LLM_PROVIDER=mock        # mock | openrouter | ollama | lmstudio | custom

# --- openrouter ---------------------------------------------------------------------------
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Необязательно: выбрать модель вручную (по умолчанию подбирается бесплатная с поддержкой tools)
# OPENROUTER_MODEL=

# --- ollama / lmstudio (модель на вашем компьютере) ---------------------------------------
# Адрес по умолчанию подходит, если сервер запущен локально. Модель берётся первая из загруженных,
# либо укажите явно. Нужна модель с поддержкой вызова инструментов (tools).
# LLM_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# --- custom (любой OpenAI-совместимый сервис) ---------------------------------------------
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
